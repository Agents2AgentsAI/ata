{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SchedulingCronRow": {
      "properties": {
        "cron_expr": {
          "type": "string"
        },
        "fire_count": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "last_fired_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Optional agent-supplied human-readable label. Empty/whitespace strings collapse to `None`; the TUI then falls back to the short id.",
          "type": [
            "string",
            "null"
          ]
        },
        "next_fire_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "recent_events": {
          "description": "Pre-formatted history records (newest last) for the `/scheduling` detail view. For in-session crons this is the per-fire ring buffer; for OS-cron rows the host leaves this empty (the TUI reads the log file directly when the user opens the detail view).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "cron_expr",
        "fire_count",
        "prompt",
        "status",
        "task_id"
      ],
      "type": "object"
    },
    "SchedulingMonitorRow": {
      "properties": {
        "command": {
          "type": "string"
        },
        "lines_emitted": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "name": {
          "description": "Optional agent-supplied human-readable label.",
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "stopped_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "tail": {
          "description": "Tail of recent output lines (already prefixed with `[stdout]` or `[stderr]`). Used by the detail view.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "command",
        "lines_emitted",
        "status",
        "task_id"
      ],
      "type": "object"
    },
    "SchedulingTasksSnapshotEvent": {
      "properties": {
        "cron_jobs": {
          "items": {
            "$ref": "#/definitions/SchedulingCronRow"
          },
          "type": "array"
        },
        "monitors": {
          "items": {
            "$ref": "#/definitions/SchedulingMonitorRow"
          },
          "type": "array"
        },
        "scheduling_enabled": {
          "description": "True iff `Feature::Scheduling` is enabled for the session. Lets the TUI distinguish \"scheduling off\" from \"scheduling on but no tasks\".",
          "type": "boolean"
        }
      },
      "required": [
        "cron_jobs",
        "monitors",
        "scheduling_enabled"
      ],
      "type": "object"
    }
  },
  "properties": {
    "event": {
      "$ref": "#/definitions/SchedulingTasksSnapshotEvent"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "event",
    "threadId"
  ],
  "title": "SchedulingTasksSnapshotNotification",
  "type": "object"
}