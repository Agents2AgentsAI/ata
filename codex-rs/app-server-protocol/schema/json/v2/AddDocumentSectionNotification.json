{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AddDocumentSectionEvent": {
      "description": "Event emitted when the agent calls `add_document_section`.",
      "properties": {
        "after_section_index": {
          "description": "Insert the new section AFTER this 0-based index. -1 for beginning.",
          "format": "int32",
          "type": "integer"
        },
        "call_id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "foldable": {
          "default": false,
          "description": "Whether the new section should be collapsible.",
          "type": "boolean"
        },
        "heading": {
          "type": "string"
        },
        "summary": {
          "default": null,
          "description": "Short summary shown when the fold is collapsed.",
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "after_section_index",
        "call_id",
        "content",
        "document_id",
        "heading",
        "turn_id"
      ],
      "type": "object"
    }
  },
  "properties": {
    "event": {
      "$ref": "#/definitions/AddDocumentSectionEvent"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "event",
    "threadId"
  ],
  "title": "AddDocumentSectionNotification",
  "type": "object"
}