      "properties": {
        "type": {
          "enum": [
            "ataLogout"
          ],
          "title": "AtaLogoutv2::LoginAccountResponseType",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "AtaLogoutv2::LoginAccountResponse",
      "type": "object"
    }
  ],
  "title": "LoginAccountResponse"
}