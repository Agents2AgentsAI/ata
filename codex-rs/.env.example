# Codex Data Tools Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATASET SOURCES
# =============================================================================

# HuggingFace (optional for public datasets, required for private/gated)
HF_TOKEN=
# Alternative name also supported:
# HUGGING_FACE_HUB_TOKEN=

# Kaggle (required for Kaggle access)
# Get your API key from: https://www.kaggle.com/settings -> API -> Create New Token
# For newer Kaggle CLI/kagglehub versions, prefer API tokens:
# KAGGLE_API_TOKEN=...
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=

# =============================================================================
# NVIDIA (for future Isaac Sim / Cosmos integration)
# =============================================================================

# Isaac Sim REST API endpoint (your EC2 instance)
ISAAC_SIM_URL=
# Example: ISAAC_SIM_URL=http://your-ec2-instance:8211

# Omniverse Nucleus server
OMNIVERSE_NUCLEUS=
# Example: OMNIVERSE_NUCLEUS=omniverse://your-nucleus-server

# NVIDIA API key (for Cosmos and NGC)
NVIDIA_API_KEY=

# Cosmos base URL (if using local deployment)
COSMOS_BASE_URL=

# =============================================================================
# STORAGE
# =============================================================================

# Local cache directory for downloaded datasets
DATA_CACHE_DIR=
# Default: ~/.cache/codex-data

# Maximum cache size in GB
DATA_CACHE_MAX_GB=50

# Maximum cache entries for API responses
DATA_CACHE_MAX_ENTRIES=10000

# =============================================================================
# CLOUD STORAGE (for future use)
# =============================================================================

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Google Cloud Storage
GOOGLE_APPLICATION_CREDENTIALS=
